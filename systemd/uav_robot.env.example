UAV_ROBOTD_ARGS="--listen-port 9001"
UAV_PROC_REALSENSE_ARGS=""
UAV_REALSENSE_WIDTH="424"
UAV_REALSENSE_HEIGHT="240"
UAV_REALSENSE_FPS="15"
UAV_REALSENSE_DISABLE_DEPTH="0"
UAV_PROC_NPU_ARGS=""
UAV_PROC_GATEWAY_ARGS=""
UAV_PROC_CAR_ARGS=""
UAV_PROC_GRIPPER_ARGS=""
UAV_PROC_ARM_ARGS=""
UAV_PROC_PIPER_ARGS=""
UAV_PROC_AIRPORT_ARGS=""
UAV_PROC_DOOR_ARGS=""
UAV_LOG_FILE="/tmp/uav_robotd.log"
UAV_TASK_STATUS_FILE="/tmp/uav_task_status.json"
UAV_VIDEO_STREAM_ENABLED="1"

# Gateway video downscale + JPEG quality. Video is a monitoring-grade
# feature, not core control. We prioritise RPC throughput on the same TCP
# port over per-frame fidelity. Defaults: scale=2 (halve W&H → ~4× less
# bytes), quality=60 (~30% smaller than 80 with no visible regression for
# operator monitoring). Together they cut video bandwidth ~7×.
UAV_GATEWAY_VIDEO_SCALE="2"
UAV_GATEWAY_JPEG_QUALITY="60"

# Arm CAN / kinematics tuning
UAV_ARM_CAN_IFACE="can4"
UAV_ARM_RPM="300"
UAV_ARM_ACC="20"
UAV_ARM_ACK_TIMEOUT_MS="200"
UAV_ARM_WAIT_REACHED="0"
UAV_ARM_REACHED_TIMEOUT_MS="8000"
UAV_ARM_HOME_SETTLE_MS="2500"
UAV_ARM_J1_RATIO="25"
UAV_ARM_J2_RATIO="20"
UAV_ARM_J3_RATIO="25"
UAV_ARM_J4_RATIO="10"
UAV_ARM_J5_RATIO="4"
UAV_ARM_J6_RATIO="1"
UAV_ARM_J1_MIN_DEG="-180"
UAV_ARM_J1_MAX_DEG="160"
UAV_ARM_J2_MIN_DEG="0"
UAV_ARM_J2_MAX_DEG="180"
UAV_ARM_J3_MIN_DEG="-80"
UAV_ARM_J3_MAX_DEG="83"
UAV_ARM_J4_MIN_DEG="-30"
UAV_ARM_J4_MAX_DEG="305"
UAV_ARM_J5_MIN_DEG="-110"
UAV_ARM_J5_MAX_DEG="110"
UAV_ARM_J6_MIN_DEG="-30"
UAV_ARM_J6_MAX_DEG="305"

# Per-joint homing direction override (0=CW forward, 1=CCW reverse).
# Default for all joints is 1 (CCW). Override per-joint when a motor is
# mechanically installed mirrored — e.g. previously we believed J2's gear
# faced opposite, but field testing on 2026-05-09 confirmed J2 was homing
# the wrong way with dir=0; flipping to dir=1 (=default) made it drive
# into the correct hard stop.
UAV_ARM_J2_ZERO_DIR="1"

# CAN chassis tuning for proc_gateway
UAV_CAR_CAN_IFACE="can3"
UAV_CAR_TRACK_WIDTH_MM="600"
UAV_CAR_MM_PER_SEC_PER_RPM="5.0"
UAV_CAR_MIN_RPM="60"
UAV_CAR_TURN_MIN_RPM="90"
UAV_CAR_LIMIT_PWM="800"
UAV_CAR_TURN_LIMIT_PWM="1200"
UAV_CAR_RAMP_STEPS="4"
UAV_CAR_RAMP_DT_MS="50"
UAV_CAR_MIN_SEND_INTERVAL_MS="120"
UAV_CAR_LEFT_TRIM="1.0"
UAV_CAR_RIGHT_TRIM="1.0"

# proc_car joystick tele-op. Plug an XInput-compatible 2.4 GHz gamepad
# receiver into the RK3588; proc_car opens UAV_CAR_JOY_DEV directly and
# translates stick motion into car_set_velocity calls (same CAN path as
# the JSON-RPC interface). Set UAV_CAR_JOY_DEV="" to disable.
#
# Control model (Xbox-style pad):
#   * Left stick:       direction (LY = forward/back, LX = turn)
#   * Right stick Y:    throttle multiplier (top=100% mid=50% bottom=10%)
#   * L2 + R2 held:     unlock full speed cap (else clamped to half)
#   * Y button:         panic-stop (force zero, overrides sticks)
#   * Release LStick:   intrinsic dead-man — direction=0 → no motion
#
# slew_lin/ang cap per-tick velocity delta so we never feed a CAN step
# input that would trip the RoboModule_DRV beeper protection.
UAV_CAR_JOY_DEV="/dev/input/js0"
UAV_CAR_JOY_DEADZONE="3000"            # direction-stick deadzone (raw axis units)
UAV_CAR_JOY_THROTTLE_DZ="2500"         # throttle-stick rest-band → fixed 50%
UAV_CAR_JOY_SEND_MS="50"               # CAN send cadence (≈20 Hz)
UAV_CAR_JOY_SLEW_LIN="4000"            # max linear delta per tick (mm/s)
UAV_CAR_JOY_SLEW_ANG="800000"          # max angular delta per tick (mdeg/s)
UAV_CAR_JOY_REOPEN_MS="2000"           # retry interval after disconnect

# Airport rails (ZDT / Emm V5.0 on CAN)
UAV_AIRPORT_CAN_IFACE="can1"
UAV_AIRPORT_RAIL1_ADDR="1"
UAV_AIRPORT_RAIL2_ADDR="2"
UAV_AIRPORT_RAIL3_ADDR="3"
UAV_AIRPORT_RAIL_RPM="1500"
UAV_AIRPORT_RAIL_ACC="0"
UAV_AIRPORT_RAIL_PULSES_PER_MM="100"

# 闭环 airport.move_mm 用的编码器当量（与上面的开环命令脉冲当量不是一回事）。
# 编码器 65536 计数/圈，所以 当量 = 65536 / 丝杆导程mm。
#   导轨1/导轨3（夹紧对, CAN addr 1/3）: 6mm 导程 → 10923
#   导轨2（addr 2）:                     1mm 导程 → 62922
# 这两组差 5.8 倍。曾经三条都回落到 62922，结果命令 5mm 实际走了 29mm。
# 2026-08-08 现场标定确认：从释放端堵转位起，命令 50mm 实测正好 50mm。
UAV_AIRPORT_RAIL1_COUNTS_PER_MM="10923"
UAV_AIRPORT_RAIL2_COUNTS_PER_MM="62922"
UAV_AIRPORT_RAIL3_COUNTS_PER_MM="10923"

# Airport relay outputs: firmware may expose GPIO_1~GPIO_3 and IO4/EXTIO4.
# proc_gateway accepts GPIO_1, GPIO1, IO4, IO_4, EXTIO4, or EXT_IO4 and
# resolves to the existing sysfs node at runtime.
UAV_AIRPORT_RELAY1_PATH="GPIO_1"
UAV_AIRPORT_RELAY1_ACTIVE_HIGH="1"
UAV_AIRPORT_RELAY2_PATH="GPIO_2"
UAV_AIRPORT_RELAY2_ACTIVE_HIGH="1"
UAV_AIRPORT_RELAY3_PATH="GPIO_3"
UAV_AIRPORT_RELAY3_ACTIVE_HIGH="1"
UAV_AIRPORT_RELAY4_PATH="IO4"
UAV_AIRPORT_RELAY4_ACTIVE_HIGH="1"
UAV_AIRPORT_GRIPPER_RELAY_PATH="IO4"
UAV_AIRPORT_GRIPPER_ACTIVE_HIGH="1"

# Airport rail-pair lock/release stall detection (the airport.lock RPC
# drives rails 0 + 2 in lock or release direction at the same time, then
# spawns a background monitor that polls each rail's ZDT 0x3A status
# register at UAV_AIRPORT_LOCK_POLL_MS cadence). Three parallel guards
# stop the rail when triggered, whichever fires first:
#
#   1. STALL-FLAG    — ZDT firmware bits 0x04/0x08 in the status byte
#                       indicate it stopped trying. Confirmed across
#                       UAV_AIRPORT_LOCK_CONFIRM_HITS samples (debounce
#                       against transient false positives).
#   2. READ-FAIL     — if status reads come back empty for
#                       UAV_AIRPORT_LOCK_READ_FAIL_HITS in a row, the
#                       motor is effectively offline (unplugged / CAN
#                       error / firmware hung). Treat as stall, stop it.
#   3. MAX-DURATION  — absolute time cap. Even if neither of the above
#                       fires, the motors get cut off after this long.
#                       Sized to be a comfortable upper bound for a
#                       healthy lock (typical lock completes in ~1s).
UAV_AIRPORT_LOCK_POLL_MS="120"
UAV_AIRPORT_LOCK_CONFIRM_HITS="2"
UAV_AIRPORT_LOCK_READ_FAIL_HITS="8"
# 锁定/释放的绝对时间上限。整段释放行程（从夹紧位退到释放端硬限位）在
# 150rpm 下要十几秒，6000ms 会在半路强停 —— 表现为"没到零点就停了"，
# 而且 rail_state_ 同样记成 STALLED，与真堵转难以区分。
UAV_AIRPORT_LOCK_MAX_MS="25000"

# 导轨2(单独控制那条)走的是另一套上限, 与上面的 LOCK_MAX_MS 无关。
# 全行程约 31mm, 归零用 60rpm 轻触要 30 秒以上, 默认 30000 会在到达硬限位
# 之前强停 —— 而超时路径同样写 RAIL_STALLED, 会被误当成"已到位"并 latch
# 一个错误的零点。
UAV_AIRPORT_RAIL2_MAX_MS="90000"

# 归零监督线程的等待窗口。必须大于对应导轨的运动时间上限, 否则导轨还没
# 撞到硬限位, 归零就已经放弃了(实际踩过: 40s 默认 < 90s 的 RAIL2_MAX_MS)。
UAV_AIRPORT_HOME_WAIT_MS="120000"

# 导轨2 的归零端与导轨1/3 相反。注意这只是方向定义不同, 不是"要把配置反
# 过来" —— 我一度理解成后者, 结果反着跑了 15mm。
# 约定: 负方向 = 归零方向, 三条导轨统一; pos_mm 也随之"远离零点为正"。
# 导轨2 的接线使得正 rpm 朝零点走, 与该约定相反, 所以翻转它的符号 ——
# 物理方向不变, 只是命令与位置的正负一起调过来, 归零方向随之变成 -1。
UAV_AIRPORT_RAIL2_REVERSE="1"
UAV_AIRPORT_RAIL2_HOME_DIR="-1"

# 归零撞到硬限位、latch 完零点后自动退开的距离。方向由归零方向推导, 不接受
# 外部传入 —— 传错符号会在刚落位时把导轨更用力地顶进限位, 这正是导轨2 被
# 反复楔死的直接原因。1mm 导程的轴停在限位里保持力极大, 未必退得出来。
UAV_AIRPORT_HOME_BACKOFF_MM="2.0"
UAV_AIRPORT_HOME_BACKOFF_RPM="150"

# 行程软限位: 归零之后, move_mm 会拒绝任何终点为负(即顶向零点侧硬限位)的
# 移动; RAIL{N}_MAX_MM > 0 时同样限制远端。0 = 不限远端。
UAV_AIRPORT_SOFT_LIMIT_MARGIN_MM="0.5"
UAV_AIRPORT_RAIL2_MAX_MM="145"

# Airport drone-platform lock motor (ZDT addr 4 on can1 by default).
# Lock command sends ENABLE + POSITION, then proc_airport waits on CAN for
# the firmware's STATUS_REACHED (0x9F) frame. If the motor doesn't reach
# target — because a drone is parked wrong, debris is wedged, etc. — we
# detect that and send STOP so the motor stops fighting the obstacle.
#
# Two detection paths run in parallel:
#   1. POSITION_STATIC: poll CMD 0x36 (read live encoder pulses) at
#      UAV_PLATFORM_POLL_INTERVAL_MS cadence. If the pulse count doesn't
#      change for UAV_PLATFORM_STALL_NO_PROG_MS while we still expect
#      motion → stall. Fast (~600ms typical) but needs firmware to
#      support 0x36.
#   2. ABSOLUTE_TIMEOUT: if we never see STATUS_REACHED within
#      UAV_PLATFORM_LOCK_TIMEOUT_MS → stall. Slower but always works.
UAV_PLATFORM_LOCK_ADDR="4"
UAV_PLATFORM_LOCK_TIMEOUT_MS="5000"
UAV_PLATFORM_STALL_NO_PROG_MS="600"
UAV_PLATFORM_POLL_INTERVAL_MS="50"

# Arm gripper UART (115200 8N1)
UAV_GRIPPER_UART_PATH="/dev/ttyUSB0"

# ── Arm backend selection (gen-1 vs gen-2) ───────────────────────────────
# 'piper'  = gen-2, proc_piper drives AgileX Piper via piper_sdk + can_piper.
# 'legacy' = gen-1, proc_arm + proc_gripper drive ZDT arm via CAN + UART.
# install_autostart.sh reads this when --backend isn't passed explicitly,
# and disables the opposite backend's systemd units.
UAV_ARM_BACKEND="piper"

# ── proc_piper (gen-2 arm) ───────────────────────────────────────────────
UAV_PIPER_CAN_IFACE="can_piper"
UAV_PIPER_SPEED="30"
UAV_PROC_PIPER_SOCK="/tmp/uav_proc_piper.sock"

# Tell proc_gateway which arm RPC socket to forward arm.* calls to.
# Defaults to /tmp/uav_proc_arm.sock (legacy) inside proc_gateway, so we
# must redirect it when running the piper backend. Switch to
# /tmp/uav_proc_arm.sock if you ever flip UAV_ARM_BACKEND back to legacy.
UAV_PROC_ARM_SOCK="/tmp/uav_proc_piper.sock"

# ── proc_door (RS485 / Modbus-RTU digital-IO module, 中盛 DIO series) ─────
# One process owns the 485 port; proc_gateway forwards door.* + helipad.*
# to it. Defaults match doorMonitor/DioPanel.cfg.json: 38400 8N1, station 1,
# 8 relay outputs + 8 discrete inputs.
#
# Physical wiring (airport, verified 2026-08-08):
#   Y1+Y2  停机坪升降   Y2=1 上升 / Y1=1 下降 / 全 0 停
#   Y3     舱门电机使能 (1=通电运动)
#   Y4     舱门方向     (0=开舱门 / 1=关舱门)
#   两轴的实际转向都与初版接线说明相反，2026-08-08 现场首测后改正,
#   修正只落在下面的 *_LEVEL / *_CH 上，代码没动。
#   X1 坪-上限位  X2 坪-下限位  X3 舱门-开到位  X4 舱门-关到位
#   全部输出关闭 = 默认安全状态
#
# NOTE: /dev/ttyUSB0 is also the legacy arm-gripper node, and USB
# enumeration order is not stable across reboots — always bind by path or
# by id, never by ttyUSBn. The by-path form below names the *physical* USB
# hub port (hub port 1), so a second adapter can never steal the node.
UAV_PROC_DOOR_ARGS=""
UAV_DOOR_UART_PATH="/dev/serial/by-path/platform-fc880000.usb-usb-0:1.1.1:1.0-port0"
UAV_DOOR_BAUD="38400"
UAV_DOOR_ADDR="1"
UAV_DOOR_OUT_COUNT="8"
UAV_DOOR_IN_COUNT="8"
UAV_DOOR_SOCK="/tmp/uav_proc_door.sock"
UAV_PROC_DOOR_SOCK="/tmp/uav_proc_door.sock"

# Motion is supervised asynchronously: a door.open / helipad.up returns as
# soon as the coils are set, and this poll loop watches the limit switches
# and the timeout, then cuts power. POLL_MS therefore bounds how far past a
# limit switch the motor can coast — keep it tight (each tick is one 0x02
# read, ~4 ms on the bus).
UAV_DOOR_POLL_MS="150"
UAV_DOOR_IN_ACTIVE_LOW="0"
# Serial transaction deadline. Paid IN FULL on every read while the
# module is silent, and proc_door's service loop is single threaded — a
# long value here starves it, requests pile up on its socket, and the
# gateway (which blocks on the forward) stops answering everything.
# The module normally replies in ~5 ms at 38400.
UAV_DOOR_MODBUS_TIMEOUT_MS="150"
# Dwell between cutting power and flipping a direction coil. Changing
# direction through a live motor is how contactors weld shut.
UAV_DOOR_DIR_SETTLE_MS="150"
# Release Y1..Y4 when proc_door exits, so a service restart can never leave
# a motor driving into a hard stop.
UAV_DOOR_RELEASE_ON_EXIT="1"

# 舱门 (enable coil + direction coil)
UAV_DOOR_HATCH_RUN_CH="3"
UAV_DOOR_HATCH_DIR_CH="4"
UAV_DOOR_HATCH_OPEN_LEVEL="0"     # Y4 level meaning "开" (field-verified)
UAV_DOOR_HATCH_OPEN_IN="3"
UAV_DOOR_HATCH_CLOSE_IN="4"
UAV_DOOR_HATCH_TIMEOUT_MS="20000"

# 停机坪 (one coil per direction, never both)
UAV_DOOR_PAD_UP_CH="2"
UAV_DOOR_PAD_DOWN_CH="1"
UAV_DOOR_PAD_TOP_IN="1"
UAV_DOOR_PAD_BOTTOM_IN="2"
UAV_DOOR_PAD_TIMEOUT_MS="30000"
